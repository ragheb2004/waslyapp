{
  "version": 2,
  "installCommand": "cd food-delivery && composer install --no-dev --prefer-dist --optimize-autoloader && npm install",
  "buildCommand": "cd food-delivery && npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "food-delivery/**"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/food-delivery/public/build/$1"
    },
    {
      "src": "/(.*\\.(?:css|js|mjs|map|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|txt|xml|json))",
      "dest": "/food-delivery/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
